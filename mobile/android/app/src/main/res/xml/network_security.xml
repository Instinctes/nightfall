<!-- Phones talk HTTP to the seed until TLS sits in front. Limited to our hosts. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">nightfallcoin.org</domain>
        <domain includeSubdomains="false">209.250.235.133</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
