/target
**/*.rs.bk
.DS_Store
.env
*.swp
.idea/
.vscode/

# Build outputs and packaged binaries (large, reproducible from source)
/dist/macos/build_*/
/dist/macos/*.dmg
/dist/macos/nightfall-core-macos-*
/dist/windows/*.zip
/dist/windows/*.exe
/dist/windows/*.dll

# Never commit key material
*.seed
*.addr.json
*.outputs.json
core.notes.json

# Release artifacts (rebuild with scripts/build-macos-dmgs.sh)
/wallets/*.dmg
/wallets/*.ipa
/wallets/windows-x64/*.exe
/mobile/ios/build/
/mobile/ios/Libs/*.a
*.xcuserstate
xcuserdata/

# The published binaries. They live on the releases page and Wrangler uploads
# them to the site from the working copy — putting 60 MB of them in git as
# well would only give the repository a second, slower copy that can drift.
/website/public/downloads/
