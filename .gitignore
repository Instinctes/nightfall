/target
**/*.rs.bk
.DS_Store
.env
*.swp
.idea/
.vscode/

# Build outputs and packaged binaries (large, reproducible from source)
/dist/macos/build_*/
/dist/macos/*.dmg
/dist/macos/nightfall-core-macos-*
/dist/windows/*.zip
/dist/windows/*.exe
/dist/windows/*.dll

# Never commit key material
*.seed
*.addr.json
*.outputs.json
core.notes.json

# Release artifacts (rebuild with scripts/build-macos-dmgs.sh)
/wallets/*.dmg
/wallets/*.ipa
/wallets/windows-x64/*.exe
/mobile/ios/build/
/mobile/ios/Libs/*.a
*.xcuserstate
xcuserdata/

# The published binaries. They live on the releases page and Wrangler uploads
# them to the site from the working copy — putting 60 MB of them in git as
# well would only give the repository a second, slower copy that can drift.
/website/public/downloads/

# Local build state and machine-specific paths. These leaked into a sync once;
# local.properties names the SDK path of whoever built last, and the rest is
# cache that is reproducible from source.
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/src/main/jniLibs/
scripts/__pycache__/

# Chain archives from scripts/make-chain-bootstrap.sh. 150 MB each, rebuilt
# from a datadir on demand and published to a release, so git would only hold
# a second copy that goes stale.
/bootstrap/

# Local working notes. They never belong in the public mirror, and being
# absent is not protection — one `git add -A` after a stray copy would be
# enough.
/brain.md
/todo.md
